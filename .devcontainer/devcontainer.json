{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",
  "name": "molexp",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": true
    },
    // FastAPI/typer backend + the molexp-ui npm workspace, so both toolchains.
    "ghcr.io/molcrafts/devcontainers/molexp:1": {}
  },
  "postCreateCommand": "uv sync --extra dev && npm install && prek install",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "molexp API (uvicorn)", "onAutoForward": "notify" }
  },
  "remoteUser": "vscode"
}
